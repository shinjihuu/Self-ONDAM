# 이 파일을 secrets.toml로 복사해서 쓰세요. (secrets.toml은 git에 올리지 마세요)
# Streamlit Cloud에서는 앱 Settings → Secrets에 붙여 넣으세요.
# 키가 있는 서비스만 OpenAI → Gemini → Groq → Hugging Face 순서로 시도하고, 모두 안 되면 규칙 기반 설명을 써요.

# (무료 사용량) Google Gemini — https://aistudio.google.com/apikey
# GEMINI_API_KEY = "..."

# (무료 사용량) Groq — https://console.groq.com/keys  (gpt-oss-20b, Llama-3.1-8B 등)
# GROQ_API_KEY = "gsk_..."

# (유료) OpenAI
# OPENAI_API_KEY = "sk-..."

# (크레딧 필요) Hugging Face — 무료 계정은 크레딧이 없어 402 오류가 날 수 있어요
# HF_TOKEN = "hf_..."

# 모델 고정 (비워 두면 후보 중 되는 모델을 자동 선택)
# GEMINI_MODEL = "gemini-2.5-flash"
# GROQ_MODEL = "openai/gpt-oss-20b"
