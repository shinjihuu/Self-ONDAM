# 이 파일을 secrets.toml로 복사해서 쓰세요. (secrets.toml은 git에 올리지 마세요)
# Streamlit Cloud에서는 앱 Settings → Secrets에 아래 내용을 붙여 넣으세요.
# 우선순위: OpenAI 키가 있으면 OpenAI → 없거나 실패하면 Hugging Face 무료 sLLM → 둘 다 없으면 규칙 기반 설명

# (선택·유료) OpenAI
# OPENAI_API_KEY = "sk-..."
# OPENAI_MODEL = "gpt-4o-mini"

# (무료) Hugging Face — https://huggingface.co/settings/tokens 에서 토큰 발급
#   권한: Fine-grained → "Make calls to Inference Providers" 체크
HF_TOKEN = "hf_..."
# HF_MODEL = "meta-llama/Llama-3.1-8B-Instruct"   # 비워 두면 지원되는 무료 모델을 자동으로 골라요
